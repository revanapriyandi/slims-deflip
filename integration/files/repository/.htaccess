DirectoryIndex index.html
# PDFs must pass attachment/member/guest checks through the SLiMS stream endpoint.
<FilesMatch "(?i:\.pdf)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
# Turn off PHP
# only for DSO as PHP Handler
# https://docs.cpanel.net/ea4/php/php-handlers/#dso
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
